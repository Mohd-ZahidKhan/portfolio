{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["get", "post"]
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "cosmosDB",
      "direction": "in",
      "name": "trackerDoc",
      "databaseName": "PortfolioDB",
      "collectionName": "LikeTracker",
      "connectionStringSetting": "CosmosDbConnectionString",
      "id": "{headers.x-forwarded-for}", 
      "partitionKey": "{headers.x-forwarded-for}"
    },
    {
      "type": "cosmosDB",
      "direction": "out",
      "name": "newTrackerDoc",
      "databaseName": "PortfolioDB",
      "collectionName": "LikeTracker",
      "connectionStringSetting": "CosmosDbConnectionString",
      "createIfNotExists": true
    },
    {
      "type": "cosmosDB",
      "direction": "in",
      "name": "counterDoc",
      "databaseName": "PortfolioDB",
      "collectionName": "VisitorStats",
      "connectionStringSetting": "CosmosDbConnectionString",
      "id": "likes-counter",
      "partitionKey": "likes-counter"
    },
    {
      "type": "cosmosDB",
      "direction": "out",
      "name": "updatedCounterDoc",
      "databaseName": "PortfolioDB",
      "collectionName": "VisitorStats",
      "connectionStringSetting": "CosmosDbConnectionString",
      "createIfNotExists": true
    }
  ]
}